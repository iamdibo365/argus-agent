# ---- LLM providers ----
LLM_PROVIDER=openai              # "openai" or "bedrock"
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ---- LangSmith observability ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=argus-agent

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...         # App-level token with connections:write (Socket Mode)

# ---- Google Drive ----
# Path to service account JSON (local dev). In AWS, inject the JSON via SSM instead.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Optional: restrict search to one shared drive/folder
GOOGLE_DRIVE_FOLDER_ID=
